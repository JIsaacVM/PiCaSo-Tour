// Generamos los 6 IDs para las tarjetas del Blog / Cultura Zapatera
const blogIds = [1, 2, 3, 4, 5, 6];
---

<div>
    <!-- Testimonios con Videos en Marquee Infinito -->
    <section id="testimonios" class="py-24 px-6 overflow-hidden">
        <div class="text-center max-w-2xl mx-auto mb-16 reveal-on-scroll">
            <h2 class="text-4xl md:text-5xl font-bold mb-4 font-serif" style="color: var(--text-color);" data-i18n="test-title">Testimonios y Videos</h2>
            <p class="font-light" style="color: var(--subtext-color);" data-i18n="test-subtitle">Vive a través de los videos oficiales lo que nuestros visitantes experimentan en la Ruta PiCaSo.</p>
        </div>

        <!-- Contenedor de Marquesinas -->
        <div class="flex flex-col gap-6 relative w-full overflow-hidden py-4">
            
            <!-- Desvanecidos laterales -->
            <div class="absolute top-0 bottom-0 left-0 w-24 bg-gradient-to-r from-[var(--bg-color)] to-transparent z-10 pointer-events-none"></div>
            <div class="absolute top-0 bottom-0 right-0 w-24 bg-gradient-to-l from-[var(--bg-color)] to-transparent z-10 pointer-events-none"></div>

            <!-- Marquee 1: Izquierda a Derecha -->
            <div class="flex w-max animate-marquee space-x-6">
                <Fragment set:html={toursMarkup()} />
                <Fragment set:html={toursMarkup()} />
                <Fragment set:html={toursMarkup()} />
                <Fragment set:html={toursMarkup()} />
            </div>

            <!-- Marquee 2: Derecha a Izquierda -->
            <div class="flex w-max animate-marquee-reverse space-x-6">
                <Fragment set:html={toursMarkupReverse()} />
                <Fragment set:html={toursMarkupReverse()} />
                <Fragment set:html={toursMarkupReverse()} />
                <Fragment set:html={toursMarkupReverse()} />
            </div>

        </div>

        <div class="text-center mt-12 reveal-on-scroll">
            <a href="https://www.youtube.com/@picasotours3476/videos" target="_blank" class="inline-block border-2 border-[#A94438] text-[#A94438] hover:bg-[#A94438] hover:text-white font-bold px-8 py-3 rounded-full transition-colors duration-300 shadow-sm" data-i18n="btn-youtube">
                Ver más en YouTube
            </a>
        </div>
    </section>

    <!-- Blog / Cultura Zapatera (6 Cards con Acordeón Independiente) -->
    <section id="blog" class="py-24 px-6 bg-[#241C15] text-white">
        <div class="max-w-6xl mx-auto">
            <div class="text-center max-w-2xl mx-auto mb-16 reveal-on-scroll">
                <h2 class="text-4xl md:text-5xl font-bold mb-4 font-serif text-[#FDFBF7]" data-i18n="blog-title">Cultura Zapatera</h2>
                <p class="text-[#D4A373] font-light" data-i18n="blog-subtitle">Artículos y curiosidades sobre la industria legendaria de León.</p>
            </div>
            
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 items-start">
                {blogIds.map((n) => (
                    <article class="blog-card relative flex flex-col bg-[#3D2C1E] p-7 rounded-3xl border border-[#5C4033] hover:border-[#D4A373] hover:shadow-2xl transition-all duration-300 reveal-on-scroll">
                        <span class="absolute top-4 right-6 font-serif text-5xl font-bold text-[#D4A373]/15 select-none" aria-hidden="true">0{n}</span>

                        <div class="text-xs font-bold text-[#A94438] mb-2 uppercase tracking-wide" data-i18n={`blog-tag-${n}`}>Cultura</div>
                        
                        <h3 class="text-xl font-bold mb-3 font-serif leading-snug" data-i18n={`blog-h-${n}`}>Título del artículo</h3>
                        
                        <div class="blog-text-container">
                            <p class="text-sm text-gray-300 mb-4 blog-preview" data-i18n={`blog-p-${n}`}>Cargando contenido...</p>
                            <div class="blog-full-content">
                                <p class="text-sm text-gray-300 mb-4 pt-1 border-t border-[#5C4033]/50" data-i18n={`blog-full-${n}`}>Cargando información completa...</p>
                            </div>
                        </div>

                        <button type="button" class="blog-toggle-btn mt-auto self-start text-[#D4A373] font-bold text-sm hover:underline flex items-center gap-1 cursor-pointer pt-2">
                            <span class="btn-text">Ver más</span>
                            <svg class="w-4 h-4 transition-transform duration-300 chevron-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                            </svg>
                        </button>
                    </article>
                ))}
            </div>
        </div>
    </section>
</div>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        // Control de acordeón independiente y fluido para las tarjetas de Cultura Zapatera
        const cards = document.querySelectorAll('.blog-card');

        cards.forEach((card) => {
            const btn = card.querySelector('.blog-toggle-btn');
            const btnText = card.querySelector('.btn-text');
            const chevron = card.querySelector('.chevron-icon');

            if (btn) {
                btn.addEventListener('click', () => {
                    const isOpen = card.classList.contains('expanded');

                    cards.forEach((otherCard) => {
                        if (otherCard !== card) {
                            otherCard.classList.remove('expanded');
                            const otherBtnText = otherCard.querySelector('.btn-text');
                            const otherChevron = otherCard.querySelector('.chevron-icon');
                            if (otherBtnText) otherBtnText.textContent = 'Ver más';
                            if (otherChevron) (otherChevron as HTMLElement).style.transform = 'rotate(0deg)';
                        }
                    });

                    if (isOpen) {
                        card.classList.remove('expanded');
                        if (btnText) btnText.textContent = 'Ver más';
                        if (chevron) (chevron as HTMLElement).style.transform = 'rotate(0deg)';
                    } else {
                        card.classList.add('expanded');
                        if (btnText) btnText.textContent = 'Ver menos';
                        if (chevron) (chevron as HTMLElement).style.transform = 'rotate(180deg)';
                    }
                });
            }
        });
    });
</script>

<style is:global>
    /* Estilos de transición para el acordeón aislado de las tarjetas */
    .blog-card {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }
    
    .blog-text-container {
        display: flex;
        flex-direction: column;
    }

    .blog-full-content {
        max-height: 0;
        opacity: 0;
        overflow: hidden;
        transition: max-height 0.4s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.3s ease-in-out;
    }

    .blog-card.expanded .blog-full-content {
        max-height: 350px;
        opacity: 1;
    }
</style>