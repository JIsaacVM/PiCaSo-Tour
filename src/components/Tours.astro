<section id="experiencias" class="py-24 px-6">
    <div class="max-w-7xl mx-auto">
        <!-- Cabecera conectada a la pestaña 'Textos' de Google Sheets -->
        <div class="text-center max-w-2xl mx-auto mb-16 reveal-on-scroll">
            <span class="text-xs text-[#A94438] font-bold uppercase tracking-widest bg-[#F5EBE1] dark:bg-[#241C15] px-4 py-1.5 rounded-full border border-[#D4A373] shadow-sm" data-i18n="tours-badge">
                Experiencias Exclusivas
            </span>
            <h2 class="text-4xl md:text-5xl font-bold mt-4 mb-4 font-serif" style="color: var(--text-color);" data-i18n="tours-title">Nuestros Tours</h2>
            <p class="font-light" style="color: var(--subtext-color);" data-i18n="tours-subtitle">Sumérgete en la ruta del calzado, la piel y el sombrero con guías expertos certificados.</p>
        </div>

        <!-- Contenedor dinámico en vivo -->
        <div id="tours-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            <!-- Esqueleto de carga inicial -->
            {[1, 2, 3].map(() => (
                <div class="stitched-border animate-pulse">
                    <div class="stitched-inner p-6 h-96 flex flex-col justify-between">
                        <div>
                            <div class="aspect-video rounded-2xl bg-[#D4A373]/20 mb-6"></div>
                            <div class="h-4 w-24 bg-[#D4A373]/20 rounded-full mb-3"></div>
                            <div class="h-6 w-3/4 bg-[#D4A373]/20 rounded mb-3"></div>
                            <div class="h-16 w-full bg-[#D4A373]/20 rounded"></div>
                        </div>
                        <div class="pt-4 border-t border-[#D4A373]/30 flex justify-between">
                            <div class="h-6 w-20 bg-[#D4A373]/20 rounded"></div>
                            <div class="h-9 w-24 bg-[#D4A373]/20 rounded-full"></div>
                        </div>
                    </div>
                </div>
            ))}
        </div>
    </div>
</section>

<script>
    function getDirectImageUrl(url) {
        if (!url || !url.startsWith('http')) return '';
        const match = url.match(/\/d\/([a-zA-Z0-9_-]+)/);
        if (match && match[1]) {
            return `https://lh3.googleusercontent.com/d/${match[1]}`;
        }
        return url;
    }

    window.renderLiveTours = function(tours = [], lang = 'es') {
        const grid = document.getElementById('tours-grid');
        if (!grid || !tours.length) return;

        const bookLabels = {
            es: 'Reservar',
            en: 'Book Now',
            fr: 'Réserver',
            jp: '予約する'
        };

        grid.innerHTML = tours.map((tour) => {
            const tourImage = getDirectImageUrl(tour.imagen || tour.image_url);
            const whatsappUrl = tour.waLink || `https://wa.me/524771668537?text=Hola,%20me%20interesa%20el%20tour%20${encodeURIComponent(tour.titulo_es || '')}`;
            const title = tour[`titulo_${lang}`] || tour.titulo_es || tour.titulo || '';
            const desc = tour[`desc_${lang}`] || tour.desc_es || tour.descripcion || '';

            return `
                <div class="stitched-border">
                    <div class="stitched-inner p-6 flex flex-col justify-between h-full">
                        <div>
                            ${tourImage ? `
                                <div class="aspect-video rounded-2xl overflow-hidden mb-6 shadow-md relative">
                                    <img src="${tourImage}" alt="${title}" class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" loading="lazy" />
                                    ${tour.duracion ? `
                                        <span class="absolute top-3 right-3 bg-black/75 backdrop-blur-sm text-white text-xs font-medium px-3 py-1 rounded-full">
                                            ⏱ ${tour.duracion}
                                        </span>
                                    ` : ''}
                                </div>
                            ` : ''}
                            <span class="text-xs text-[#A94438] font-bold uppercase tracking-widest bg-[#F5EBE1] dark:bg-[#241C15] px-3 py-1 rounded-full inline-block mb-3">
                                ${tour.categoria || 'Tour Vivencial'}
                            </span>
                            <h3 class="font-bold text-xl md:text-2xl mb-3 font-serif tour-title"
                                data-es="${tour.titulo_es || ''}"
                                data-en="${tour.titulo_en || ''}"
                                data-fr="${tour.titulo_fr || ''}"
                                data-jp="${tour.titulo_jp || ''}">
                                ${title}
                            </h3>
                            <p class="text-sm mb-6 line-clamp-3 tour-desc" style="color: var(--subtext-color);"
                                data-es="${tour.desc_es || ''}"
                                data-en="${tour.desc_en || ''}"
                                data-fr="${tour.desc_fr || ''}"
                                data-jp="${tour.desc_jp || ''}">
                                ${desc}
                            </p>
                        </div>
                        <div class="pt-4 border-t border-[#D4A373]/30 flex items-center justify-between">
                            <span class="font-bold text-lg text-[#A94438]">${tour.precio || '$--'}</span>
                            <a href="${whatsappUrl}" target="_blank" class="bg-[#A94438] hover:bg-[#8e382f] text-white text-sm font-bold px-5 py-2.5 rounded-full transition-colors shadow-sm" data-i18n="btn-book">
                                ${bookLabels[lang] || 'Reservar'}
                            </a>
                        </div>
                    </div>
                </div>
            `;
        }).join('');
    };
</script>