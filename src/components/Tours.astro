---
export interface Props {
    tours: Array<{ 
        id: string; 
        titulo: { es: string; en: string; fr: string; jp: string }; 
        duracion: string; 
        descripcion: { es: string; en: string; fr: string; jp: string }; 
        imagen: string; 
        waLink: string 
    }>;
}
const { tours } = Astro.props;
---
<section id="experiencias" class="py-24 px-6 border-y border-[#D4A373]/50" style="background-color: var(--card-bg);">
    <div class="text-center max-w-2xl mx-auto mb-16 reveal-on-scroll">
        <h2 class="text-4xl md:text-5xl font-bold mb-4 font-serif" style="color: var(--text-color);" data-i18n="exp-title">Experiencias Exclusivas</h2>
        <p class="font-light" style="color: var(--subtext-color);" data-i18n="exp-subtitle">Conoce nuestros recorridos temáticos de descubrimiento económico, aventura y turismo regenerativo.</p>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 max-w-7xl mx-auto">
        {tours.map((tour) => (
            <div class="rounded-3xl border border-[#D4A373] overflow-hidden hover:border-[#A94438] hover:-translate-y-2 transition-all duration-500 flex flex-col justify-between shadow-xl group reveal-on-scroll" style="background-color: var(--bg-color);">
                <div class="h-48 bg-[#EED9C4] flex items-center justify-center text-[#5C4033] text-sm font-serif italic border-b border-[#D4A373] overflow-hidden relative">
                    <span class="group-hover:scale-110 transition-transform duration-700 font-bold">{tour.imagen || 'Tour PiCaSo'}</span>
                </div>
                <div class="p-7 flex flex-col flex-grow">
                    <span class="text-xs text-[#A94438] font-bold uppercase tracking-widest bg-[#F5EBE1] px-3.5 py-1 rounded-full w-max mb-3 border border-[#D4A373] shadow-sm">{tour.duracion}</span>
                    
                    <!-- Título dinámico multilingüe -->
                    <h3 class="text-2xl font-bold mb-3 font-serif tour-title" style="color: var(--text-color);" 
                        data-es={tour.titulo.es} 
                        data-en={tour.titulo.en} 
                        data-fr={tour.titulo.fr} 
                        data-jp={tour.titulo.jp}>
                        {tour.titulo.es}
                    </h3>

                    <!-- Descripción dinámica multilingüe -->
                    <p class="text-sm mb-8 flex-grow leading-relaxed font-light tour-desc" style="color: var(--subtext-color);" 
                        data-es={tour.descripcion.es} 
                        data-en={tour.descripcion.en} 
                        data-fr={tour.descripcion.fr} 
                        data-jp={tour.descripcion.jp}>
                        {tour.descripcion.es}
                    </p>

                    <a href={tour.waLink || "https://wa.me/524771668537"} target="_blank" class="block w-full text-center bg-[#3D2C1E] hover:bg-[#241C15] text-white font-bold py-3.5 rounded-2xl transition-all duration-300 shadow-md hover:scale-[1.02] text-sm active:scale-95" data-i18n="btn-book">
                        Reservar
                    </a>
                </div>
            </div>
        ))}
    </div>
</section>