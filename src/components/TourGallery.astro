<script>
    window.renderLiveGallery = function(galleryItems = [], lang = 'es') {
        const container = document.getElementById('bento-gallery-grid');
        if (!container || !galleryItems.length) return;

        container.innerHTML = galleryItems.map((item) => {
            const rawUrl = item.imagen || item.image_url || '';
            const match = rawUrl.match(/\/d\/([a-zA-Z0-9_-]+)/);
            const imgUrl = match && match[1] ? `https://lh3.googleusercontent.com/d/${match[1]}` : rawUrl;
            const title = item[`titulo_${lang}`] || item.titulo_es || '';
            const tag = item[`tag_${lang}`] || item.tag_es || '';
            const spanClasses = `${item.col_span || 'md:col-span-1'} ${item.row_span || 'md:row-span-1'}`;

            return `
                <div class="group relative rounded-3xl overflow-hidden shadow-lg ${spanClasses} min-h-[260px]">
                    <img src="${imgUrl}" alt="${title}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" loading="lazy" />
                    <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent flex flex-col justify-end p-6">
                        ${tag ? `<span class="text-xs font-bold uppercase tracking-widest text-[#D4A373] mb-1 gallery-tag" data-es="${item.tag_es || ''}" data-en="${item.tag_en || ''}" data-fr="${item.tag_fr || ''}" data-jp="${item.tag_jp || ''}">${tag}</span>` : ''}
                        <h3 class="text-white font-serif text-xl md:text-2xl font-bold gallery-title" data-es="${item.titulo_es || ''}" data-en="${item.titulo_en || ''}" data-fr="${item.titulo_fr || ''}" data-jp="${item.titulo_jp || ''}">${title}</h3>
                    </div>
                </div>
            `;
        }).join('');
    };
</script>