---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import Tours from '../components/Tours.astro';
import TourGallery from '../components/TourGallery.astro';
import TestimonialsAndBlog from '../components/TestimonialsAndBlog.astro';

// Conexión a tu Google Apps Script
const API_URL = "https://script.google.com/macros/s/AKfycbwEx00QDVSBiFseXgP6sXa6nAvcE0hIUKdKginG1lxAErZbyv8yugaLY9p2QscXJit5rg/exec";

let apiData = {
    tours: [],
    translations: {},
    gallery: []
};

try {
    const res = await fetch(API_URL);
    const json = await res.json();
    if (json.tours) apiData.tours = json.tours;
    if (json.translations) apiData.translations = json.translations;
    if (json.gallery) apiData.gallery = json.gallery;
} catch (e) {
    console.error("Error al conectar con Google Sheets:", e);
}
---

<html lang="es" class="scroll-smooth">
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>PiCaSo Tours | Experiencias de Identidad Leonesa</title>
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,600;0,700;1,400&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
        <style>
            :root {
                --bg-color: #FDFBF7;
                --text-color: #241C15;
                --card-bg: #FDFBF7;
                --card-border: #D4A373;
                --nav-bg: rgba(255, 255, 255, 0.85);
                --subtext-color: #5C4033;
            }
            .dark {
                --bg-color: #120D0A;
                --text-color: #FDFBF7;
                --card-bg: #1A1410;
                --card-border: #5C4033;
                --nav-bg: rgba(26, 20, 16, 0.85);
                --subtext-color: #D4A373;
            }
            body {
                font-family: 'Plus Jakarta Sans', sans-serif;
                background-color: var(--bg-color);
                color: var(--text-color);
                transition: background-color 0.3s ease, color 0.3s ease;
            }
            h1, h2, h3, .font-serif {
                font-family: 'Cormorant Garamond', serif;
            }
            .stitched-border {
                border: 2px dashed var(--card-border);
                border-radius: 1.5rem;
                padding: 2px;
            }
            .stitched-inner {
                background: var(--card-bg);
                border-radius: 1.3rem;
                height: 100%;
            }
            .reveal-on-scroll {
                opacity: 0;
                transform: translateY(30px);
                transition: all 0.8s cubic-bezier(0.16, 1, 0.3, 1);
            }
            .reveal-on-scroll.is-visible {
                opacity: 1;
                transform: translateY(0);
            }
        </style>
    </head>
    <body class="overflow-x-hidden pt-28 selection:bg-[#D4A373] selection:text-[#241C15]">

        <!-- Redes Sociales Flotantes -->
        <div class="fixed right-4 top-1/2 -translate-y-1/2 z-50 flex flex-col gap-3">
