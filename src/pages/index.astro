---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import Tours from '../components/Tours.astro';
import TourGallery from '../components/TourGallery.astro';
import TestimonialsAndBlog from '../components/TestimonialsAndBlog.astro';
---

<html lang="es">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>PiCaSo Tours | Experiencias en León, Guanajuato</title>
</head>
<body>
    <Navbar />
    <main>
        <Hero />
        <About />
        <Tours />
        <TourGallery />
        <TestimonialsAndBlog />
    </main>

    <script>
        const API_URL = "https://script.google.com/macros/s/AKfycbw3cCbklFVlmP3lm4g-4ja0jz7hUqigPJYW7h7-BX_leafojkmfcUovOFwrVUCO_TzF/exec";

        async function syncLiveGoogleSheet() {
            try {
                const currentLang = localStorage.getItem('lang') || 'es';
                // ?t=Date.now() obliga a traer siempre los datos más recientes de Google Sheets
                const response = await fetch(`${API_URL}?t=${Date.now()}`);
                const data = await response.json();

                // 1. Actualizar textos generales (pestaña 'Textos')
                if (data.translations) {
                    window.translations = data.translations;
                    if (typeof window.setLanguage === 'function') {
                        window.setLanguage(currentLang);
                    }
                }

                // 2. Actualizar tarjetas de Tours y precios (pestaña 'Tours')
                if (data.Tours && typeof window.renderLiveTours === 'function') {
                    window.renderLiveTours(data.Tours, currentLang);
                }

                // 3. Actualizar galería Bento Grid (pestaña 'Gallery')
                if (data.Gallery && typeof window.renderLiveGallery === 'function') {
                    window.renderLiveGallery(data.Gallery, currentLang);
                }
            } catch (error) {
                console.error("Error cargando datos en tiempo real desde Google Sheets:", error);
            }
        }

        document.addEventListener('DOMContentLoaded', syncLiveGoogleSheet);
    </script>
</body>
</html>